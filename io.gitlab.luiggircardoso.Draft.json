    "modules" : [
    	{
	      "name": "blueprint-compiler",
	      "buildsystem": "meson",
	      "sources": [
		{
		  "type": "git",
		  "url": "https://gitlab.gnome.org/GNOME/blueprint-compiler.git",
		  "tag": "v0.20.4"
		}
	      ]
	    },
        {
            "name" : "draft",
            "builddir" : true,
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://gitlab.com/luiggircardoso/draft.git",
                    "tag" : "v2.0",
                    "commit" : "68547c2f3f2ae0a96a7188ae5d2f36032d14a77b"
                }
            ],
            "config-opts" : [
                "-Dprofile=release"
            ]
        }
    ]
}
